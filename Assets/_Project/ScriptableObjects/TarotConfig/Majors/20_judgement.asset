  _uprightDescription: "\u5BA1\u5224\u724C\u547C\u5524\u4F60\u56DE\u5E94\u5185\u5FC3\u7684\u53EC\u5524\uFF0C\u89C9\u9192\u4E8E\u66F4\u9AD8\u7684\u81EA\u6211\u3002\u4F60\u6B63\u88AB\u9080\u8BF7\u8FDB\u884C\u4E00\u6B21\u6DF1\u523B\u7684\u81EA\u6211\u5BA1\u89C6\u4E0E\u91CD\u751F\u3002\u653E\u4E0B\u8FC7\u53BB\u7684\u5305\u88B1\uFF0C\u56DE\u5E94\u90A3\u4E2A\u8BA9\u4F60\u7075\u9B42\u632F\u52A8\u7684\u4F7F\u547D\u3002"
  _reversedDescription: "\u9006\u4F4D\u7684\u5BA1\u5224\u6697\u793A\u4F60\u53EF\u80FD\u6B63\u5728\u9003\u907F\u5185\u5FC3\u7684\u53EC\u5524\uFF0C\u6216\u88AB\u8FC7\u5EA6\u7684\u81EA\u8D23\u6240\u56F0\u3002\u4E0D\u8981\u5FFD\u89C6\u90A3\u4E9B\u6765\u81EA\u6DF1\u5C42\u81EA\u6211\u7684\u4FE1\u53F7\u3002\u5BBD\u6055\u81EA\u5DF1\uFF0C\u63A5\u7EB3\u8FC7\u53BB\uFF0C\u7136\u540E\u52C7\u6562\u524D\u884C\u3002"
