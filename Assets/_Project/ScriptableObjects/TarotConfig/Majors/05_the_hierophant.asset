  _uprightDescription: "\u6559\u7687\u4EE3\u8868\u4F20\u7EDF\u7684\u667A\u6167\u548C\u7CBE\u795E\u7684\u5F15\u5BFC\u3002\u4F60\u6216\u8BB8\u6B63\u5BFB\u6C42\u5BFC\u5E08\u7684\u5EFA\u8BAE\uFF0C\u6216\u5728\u65E2\u6709\u7684\u4F53\u7CFB\u4E2D\u5BFB\u627E\u610F\u4E49\u3002\u9075\u4ECE\u5185\u5FC3\u7684\u4FE1\u5FF5\uFF0C\u540C\u65F6\u5C0A\u91CD\u524D\u4EBA\u7684\u7ECF\u9A8C\u4E0E\u6559\u5BFC\u3002"
  _reversedDescription: "\u9006\u4F4D\u7684\u6559\u7687\u9F13\u52B1\u4F60\u6253\u7834\u5E38\u89C4\uFF0C\u8D28\u7591\u65E2\u5B9A\u7684\u6559\u6761\u3002\u4F20\u7EDF\u7684\u9053\u8DEF\u672A\u5FC5\u9002\u5408\u6B64\u523B\u7684\u4F60\u3002\u6562\u4E8E\u8D70\u81EA\u5DF1\u7684\u8DEF\uFF0C\u771F\u6B63\u7684\u6210\u957F\u5F80\u5F80\u6E90\u4E8E\u5BF9\u65E7\u7ED3\u6784\u7684\u8D85\u8D8A\u3002"
