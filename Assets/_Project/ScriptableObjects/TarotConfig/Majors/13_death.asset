  _uprightDescription: "\u6B7B\u795E\u724C\u5E76\u975E\u5B57\u9762\u610F\u4E49\u4E0A\u7684\u6B7B\u4EA1\uFF0C\u800C\u662F\u65E7\u9636\u6BB5\u7684\u5F7B\u5E95\u7EC8\u7ED3\u3002\u53EA\u6709\u653E\u4E0B\u4E0D\u518D\u670D\u52A1\u4E8E\u4F60\u7684\u4E8B\u7269\uFF0C\u624D\u80FD\u4E3A\u65B0\u751F\u817E\u51FA\u7A7A\u95F4\u3002\u62E5\u62B1\u8FD9\u573A\u8715\u53D8\uFF0C\u5B83\u662F\u4F60\u8FDB\u5316\u7684\u5FC5\u7ECF\u4E4B\u8DEF\u3002"
  _reversedDescription: "\u9006\u4F4D\u7684\u6B7B\u795E\u63D0\u793A\u4F60\u6B63\u5728\u6297\u62D2\u5FC5\u8981\u7684\u6539\u53D8\u3002\u7D27\u6293\u7740\u8FC7\u65F6\u7684\u5173\u7CFB\u3001\u5DE5\u4F5C\u6216\u4FE1\u5FF5\uFF0C\u53EA\u4F1A\u8BA9\u4F60\u505C\u6EDE\u4E0D\u524D\u3002\u5141\u8BB8\u65E7\u7684\u6B7B\u53BB\uFF0C\u65B0\u7684\u624D\u80FD\u8BDE\u751F\u2014\u2014\u4F60\u51C6\u5907\u597D\u4E86\u5417\uFF1F"
