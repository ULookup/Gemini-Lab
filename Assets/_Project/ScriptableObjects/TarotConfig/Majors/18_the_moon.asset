  _uprightDescription: "\u6708\u4EAE\u5E26\u4F60\u8D70\u8FDB\u6F5C\u610F\u8BC6\u7684\u8FF7\u96FE\uFF0C\u90A3\u91CC\u85CF\u7740\u672A\u88AB\u5BDF\u89C9\u7684\u771F\u76F8\u4E0E\u6050\u60E7\u3002\u753B\u9762\u53EF\u80FD\u626D\u66F2\uFF0C\u8DEF\u5F84\u53EF\u80FD\u4E0D\u6E05\uFF0C\u4F46\u8BF7\u76F8\u4FE1\u4F60\u7684\u76F4\u89C9\u3002\u7A7F\u8D8A\u8FD9\u573A\u5E7B\u89C9\uFF0C\u4F60\u5C06\u66F4\u63A5\u8FD1\u771F\u5B9E\u7684\u81EA\u5DF1\u3002"
  _reversedDescription: "\u9006\u4F4D\u7684\u6708\u4EAE\u9884\u793A\u8FF7\u96FE\u6B63\u5728\u6D88\u6563\uFF0C\u9690\u85CF\u7684\u771F\u76F8\u5373\u5C06\u663E\u73B0\u3002\u56F0\u60D1\u548C\u6050\u60E7\u5C06\u9010\u6E10\u892A\u53BB\uFF0C\u4F60\u5F00\u59CB\u770B\u6E05\u4E8B\u7269\u7684\u672C\u6765\u9762\u76EE\u3002\u8FD9\u662F\u4E00\u4E2A\u91CA\u653E\u548C\u6F84\u660E\u7684\u65F6\u523B\u3002"
