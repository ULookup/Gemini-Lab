  _uprightDescription: "\u7687\u540E\u662F\u5927\u81EA\u7136\u7684\u4E30\u9976\u5316\u8EAB\uFF0C\u9884\u793A\u521B\u9020\u529B\u4E0E\u751F\u547D\u529B\u7684\u84EC\u52C3\u3002\u4F60\u6B63\u5904\u5728\u4E00\u4E2A\u6ECB\u517B\u4E0E\u88AB\u6ECB\u517B\u7684\u9636\u6BB5\uFF0C\u4EAB\u53D7\u611F\u5B98\u7684\u6109\u60A6\uFF0C\u8BA9\u7F8E\u597D\u81EA\u7136\u751F\u957F\u3002\u62E5\u62B1\u4F60\u7684\u6E29\u67D4\u4E0E\u529B\u91CF\u3002"
  _reversedDescription: "\u9006\u4F4D\u7684\u7687\u540E\u53EF\u80FD\u6697\u793A\u8FC7\u5EA6\u4F9D\u8D56\u4ED6\u4EBA\u6216\u8FC7\u5EA6\u4FDD\u62A4\u81EA\u5DF1\u3002\u521B\u9020\u529B\u53D7\u5230\u963B\u6EDE\uFF0C\u4F60\u9700\u8981\u91CD\u65B0\u627E\u5230\u81EA\u6211\u6ECB\u517B\u7684\u65B9\u5F0F\u3002\u7ED9\u5185\u5FC3\u82B1\u56ED\u6D47\u6C34\uFF0C\u800C\u4E0D\u662F\u7B49\u5F85\u4ED6\u4EBA\u704C\u6E89\u3002"
  _artwork: {fileID: 21300000, guid: 42837da2943b66340a90e7208d4faf47, type: 3}
