  _uprightDescription: "\u661F\u661F\u662F\u66B4\u98CE\u96E8\u540E\u7684\u5B81\u9759\uFF0C\u662F\u5E0C\u671B\u7684\u706F\u5854\u3002\u7ECF\u5386\u78E8\u96BE\u540E\u7684\u4F60\uFF0C\u6B63\u6C90\u6D74\u5728\u7597\u6108\u7684\u5149\u8292\u4E2D\u3002\u76F8\u4FE1\u5B87\u5B99\u7684\u6069\u5178\uFF0C\u4F60\u7684\u613F\u671B\u6B63\u5728\u661F\u7A7A\u4E0B\u6084\u7136\u6210\u5F62\uFF0C\u4FDD\u6301\u4FE1\u5FF5\u3002"
  _reversedDescription: "\u9006\u4F4D\u7684\u661F\u661F\u610F\u5473\u7740\u4F60\u53EF\u80FD\u6B63\u7ECF\u5386\u5931\u671B\u6216\u4FE1\u5FF5\u7684\u52A8\u6447\u3002\u90A3\u9053\u5149\u4F3C\u4E4E\u6682\u65F6\u6697\u6DE1\u4E86\uFF0C\u4F46\u5B83\u4ECE\u672A\u6D88\u5931\u3002\u91CD\u65B0\u8FDE\u63A5\u4F60\u7684\u5E0C\u671B\u4E4B\u6E90\uFF0C\u54EA\u6015\u53EA\u662F\u4E00\u4E1D\u5FAE\u5149\u4E5F\u8DB3\u4EE5\u6307\u5F15\u65B9\u5411\u3002"
