  _uprightDescription: "\u8282\u5236\u5929\u4F7F\u6559\u5BFC\u4F60\u5E73\u8861\u4E0E\u8C03\u548C\u7684\u827A\u672F\u3002\u4E0D\u504F\u4E0D\u501A\u3001\u4E0D\u6025\u4E0D\u7F13\uFF0C\u5728\u770B\u4F3C\u5BF9\u7ACB\u7684\u5143\u7D20\u4E2D\u627E\u5230\u548C\u8C10\u3002\u8010\u5FC3\u7B49\u5F85\u4E8B\u7269\u81EA\u7136\u878D\u5408\uFF0C\u7F8E\u5C06\u5728\u6070\u5230\u597D\u5904\u7684\u65F6\u523B\u663E\u73B0\u3002"
  _reversedDescription: "\u9006\u4F4D\u7684\u8282\u5236\u6697\u793A\u751F\u6D3B\u4E2D\u67D0\u5904\u5931\u53BB\u4E86\u5E73\u8861\u3002\u8FC7\u5EA6\u6C89\u8FF7\u6216\u8FC7\u5EA6\u538B\u6291\u90FD\u5728\u6D88\u8017\u4F60\u3002\u627E\u56DE\u4E2D\u9053\uFF0C\u8BA9\u8282\u594F\u6162\u4E0B\u6765\uFF0C\u5728\u7B80\u5355\u4E2D\u91CD\u5EFA\u8EAB\u5FC3\u7684\u548C\u8C10\u3002"
