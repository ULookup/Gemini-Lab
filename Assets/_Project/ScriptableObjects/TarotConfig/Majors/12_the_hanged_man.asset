  _uprightDescription: "\u5012\u540A\u4EBA\u9080\u8BF7\u4F60\u6362\u4E00\u4E2A\u89D2\u5EA6\u770B\u4E16\u754C\u3002\u6709\u65F6\u653E\u4E0B\u6267\u5FF5\u3001\u6682\u505C\u884C\u52A8\uFF0C\u53CD\u800C\u80FD\u83B7\u5F97\u66F4\u6DF1\u7684\u6D1E\u89C1\u3002\u8FD9\u4EFD\u727A\u7272\u5E76\u975E\u635F\u5931\uFF0C\u800C\u662F\u4EE5\u65B0\u7684\u65B9\u5F0F\u7406\u89E3\u751F\u547D\u7684\u793C\u7269\u3002"
  _reversedDescription: "\u9006\u4F4D\u7684\u5012\u540A\u4EBA\u6697\u793A\u4F60\u53EF\u80FD\u5728\u65E0\u8C13\u5730\u62D6\u5EF6\u6216\u56FA\u6267\u5730\u62D2\u7EDD\u6539\u53D8\u89C6\u89D2\u3002\u727A\u7272\u82E5\u4E0D\u80FD\u5E26\u6765\u6210\u957F\u4FBF\u53EA\u662F\u53D7\u82E6\u3002\u95EE\u95EE\u81EA\u5DF1\uFF1A\u4F60\u5728\u7B49\u5F85\u4EC0\u4E48\uFF1F\u884C\u52A8\u4E5F\u8BB8\u624D\u662F\u7B54\u6848\u3002"
  _artwork: {fileID: 21300000, guid: 7a32ab9a40bc5324ca8c6715fbb48b7e, type: 3}
