  _uprightDescription: "\u592A\u9633\u662F\u5854\u7F57\u4E2D\u6700\u660E\u4EAE\u7684\u724C\u4E4B\u4E00\uFF0C\u5E26\u6765\u7EAF\u7CB9\u7684\u559C\u60A6\u548C\u751F\u547D\u529B\u3002\u4F60\u6B63\u6C90\u6D74\u5728\u6E29\u6696\u4E0E\u6210\u529F\u7684\u9633\u5149\u4E0B\uFF0C\u4E00\u5207\u90FD\u6E05\u6670\u53EF\u89C1\u3002\u4EAB\u53D7\u8FD9\u4EFD\u6B22\u6109\uFF0C\u8FD9\u662F\u4F60\u503C\u5F97\u62E5\u6709\u7684\u5E78\u798F\u65F6\u5149\u3002"
  _reversedDescription: "\u9006\u4F4D\u7684\u592A\u9633\u5E76\u4E0D\u4EE3\u8868\u9ED1\u6697\uFF0C\u53EA\u662F\u6682\u65F6\u7684\u4E4C\u4E91\u906E\u4F4F\u4E86\u5149\u8292\u3002\u4F60\u6216\u8BB8\u6B63\u7ECF\u5386\u4FE1\u5FC3\u4E0D\u8DB3\u6216\u6B22\u6109\u7684\u5EF6\u8FDF\u3002\u8BF7\u8BB0\u4F4F\u592A\u9633\u59CB\u7EC8\u5728\u90A3\u91CC\uFF0C\u4E91\u5C42\u7EC8\u5C06\u6563\u53BB\u3002"
  _artwork: {fileID: 21300000, guid: d4ec91312c25e224c956659ce8cb4542, type: 3}
