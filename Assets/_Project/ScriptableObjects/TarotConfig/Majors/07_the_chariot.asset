  _uprightDescription: "\u6218\u8F66\u9884\u793A\u4F60\u5C06\u51ED\u501F\u610F\u5FD7\u529B\u514B\u670D\u969C\u788D\u3001\u53D6\u5F97\u80DC\u5229\u3002\u4F60\u9700\u8981\u9A7E\u9A6D\u5185\u5FC3\u77DB\u76FE\u7684\u529B\u91CF\uFF0C\u5C06\u5B83\u4EEC\u6574\u5408\u4E3A\u524D\u8FDB\u7684\u52A8\u529B\u3002\u65B9\u5411\u660E\u786E\u3001\u51B3\u5FC3\u575A\u5B9A\uFF0C\u4F60\u52BF\u4E0D\u53EF\u6321\u3002"
  _reversedDescription: "\u9006\u4F4D\u7684\u6218\u8F66\u63D0\u793A\u4F60\u53EF\u80FD\u6B63\u5931\u53BB\u5BF9\u5C40\u52BF\u7684\u638C\u63A7\u3002\u5185\u5FC3\u7684\u51B2\u52A8\u548C\u5916\u90E8\u7684\u963B\u529B\u8BA9\u4F60\u4E3E\u6B65\u7EF4\u8270\u3002\u505C\u4E0B\u6765\u91CD\u65B0\u8C03\u6574\u65B9\u5411\uFF0C\u6BD4\u76F2\u76EE\u731B\u51B2\u66F4\u660E\u667A\u3002"
