  _uprightDescription: "\u9690\u58EB\u9080\u8BF7\u4F60\u6682\u65F6\u9000\u9690\uFF0C\u5411\u5185\u5BFB\u627E\u7B54\u6848\u3002\u4F60\u9700\u8981\u7684\u4E0D\u662F\u66F4\u591A\u7684\u4FE1\u606F\uFF0C\u800C\u662F\u5B89\u9759\u7684\u6C89\u601D\u3002\u5728\u72EC\u5904\u4E2D\uFF0C\u90A3\u76CF\u5185\u5728\u7684\u660E\u706F\u4F1A\u6307\u5F15\u4F60\u771F\u6B63\u6E34\u671B\u7684\u65B9\u5411\u3002"
  _reversedDescription: "\u9006\u4F4D\u7684\u9690\u58EB\u8B66\u544A\u8FC7\u5EA6\u7684\u5B64\u72EC\u53EF\u80FD\u53D8\u6210\u5B64\u7ACB\u3002\u4F60\u6216\u8BB8\u56E0\u4E3A\u5BB3\u6015\u53D7\u4F24\u800C\u62D2\u7EDD\u4ED6\u4EBA\u7684\u63F4\u624B\u3002\u662F\u65F6\u5019\u8D70\u51FA\u5185\u5FC3\u7684\u6D1E\u7A9F\uFF0C\u8BA9\u4FE1\u4EFB\u7684\u4EBA\u91CD\u65B0\u8FDB\u5165\u4F60\u7684\u4E16\u754C\u3002"
