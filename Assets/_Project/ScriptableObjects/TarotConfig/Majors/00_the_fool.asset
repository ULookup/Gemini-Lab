  _uprightDescription: "\u611A\u8005\u8C61\u5F81\u7740\u4E00\u6BB5\u5168\u65B0\u65C5\u7A0B\u7684\u5F00\u542F\u3002\u4F60\u6B63\u7AD9\u5728\u8D77\u70B9\uFF0C\u5E26\u7740\u7EAF\u771F\u7684\u5FC3\u548C\u5BF9\u672A\u77E5\u7684\u597D\u5947\uFF0C\u51C6\u5907\u8DC3\u5165\u5168\u65B0\u7684\u4F53\u9A8C\u3002\u8FD9\u662F\u62E5\u62B1\u53EF\u80FD\u6027\u3001\u653E\u4E0B\u987E\u8651\u7684\u65F6\u523B\uFF0C\u5B87\u5B99\u9080\u8BF7\u4F60\u8FC8\u51FA\u7B2C\u4E00\u6B65\u3002"
  _reversedDescription: "\u9006\u4F4D\u7684\u611A\u8005\u63D0\u793A\u4F60\u53EF\u80FD\u56E0\u51B2\u52A8\u800C\u5FFD\u89C6\u4E86\u98CE\u9669\u3002\u4F60\u9700\u8981\u6682\u505C\u811A\u6B65\uFF0C\u91CD\u65B0\u5BA1\u89C6\u8BA1\u5212\u662F\u5426\u5468\u5168\u3002\u4E0D\u8981\u56E0\u4E3A\u5BB3\u6015\u9519\u8FC7\u800C\u4ED3\u4FC3\u884C\u52A8\uFF0C\u8C28\u614E\u5E76\u975E\u80C6\u602F\u3002"
