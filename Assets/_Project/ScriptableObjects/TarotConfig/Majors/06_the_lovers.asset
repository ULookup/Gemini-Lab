  _uprightDescription: "\u604B\u4EBA\u724C\u4E0D\u4EC5\u5173\u4E4E\u7231\u60C5\uFF0C\u66F4\u5173\u4E4E\u4EF7\u503C\u89C2\u7684\u6289\u62E9\u3002\u4F60\u6B63\u9762\u4E34\u4E00\u4E2A\u91CD\u8981\u7684\u9009\u62E9\uFF0C\u9700\u8981\u5FE0\u4E8E\u5185\u5FC3\u7684\u771F\u5B9E\u6B32\u671B\u3002\u771F\u8BDA\u7684\u8FDE\u63A5\u4E0E\u6C9F\u901A\uFF0C\u5C06\u5E26\u6765\u6DF1\u523B\u7684\u5173\u7CFB\u5347\u534E\u3002"
  _reversedDescription: "\u9006\u4F4D\u7684\u604B\u4EBA\u6697\u793A\u5173\u7CFB\u4E2D\u7684\u4E0D\u548C\u8C10\u6216\u5185\u5FC3\u4EF7\u503C\u7684\u51B2\u7A81\u3002\u4F60\u53EF\u80FD\u5728\u72B9\u8C6B\u4E2D\u5F98\u5F8A\uFF0C\u65E0\u6CD5\u505A\u51FA\u9009\u62E9\u3002\u6B63\u89C6\u771F\u5B9E\u7684\u6E34\u671B\uFF0C\u907F\u514D\u56E0\u6050\u60E7\u800C\u56DE\u907F\u5FC5\u8981\u7684\u51B3\u5B9A\u3002"
