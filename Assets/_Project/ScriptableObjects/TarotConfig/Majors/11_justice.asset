  _uprightDescription: "\u6B63\u4E49\u724C\u63D0\u9192\u4F60\u56E0\u679C\u6CD5\u5219\u6C38\u4E0D\u7F3A\u5E2D\u3002\u4F60\u7684\u51B3\u5B9A\u5C06\u5E26\u6765\u76F8\u5E94\u7684\u540E\u679C\uFF0C\u8BF7\u4EE5\u5BA2\u89C2\u548C\u516C\u6B63\u7684\u6001\u5EA6\u505A\u51FA\u5224\u65AD\u3002\u771F\u76F8\u5C06\u88AB\u63ED\u793A\uFF0C\u516C\u5E73\u5C06\u5F97\u5230\u4F38\u5F20\u3002"
  _reversedDescription: "\u9006\u4F4D\u7684\u6B63\u4E49\u6697\u793A\u4E0D\u516C\u5E73\u7684\u5C40\u9762\u6216\u9003\u907F\u8D23\u4EFB\u7684\u503E\u5411\u3002\u4F60\u53EF\u80FD\u5728\u67D0\u4E2A\u95EE\u9898\u4E0A\u504F\u9887\u5BF9\u5F85\u81EA\u5DF1\u6216\u4ED6\u4EBA\u3002\u8BDA\u5B9E\u5730\u9762\u5BF9\u56E0\u679C\uFF0C\u62D6\u5EF6\u53EA\u4F1A\u8BA9\u8D26\u672C\u66F4\u6C89\u91CD\u3002"
